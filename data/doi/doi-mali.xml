    <iati-identifier>US-GOV-9-F21AP01413-62959</iati-identifier>
    <reporting-org ref="US-GOV-9" type="10">
      <narrative>Department of the Interior</narrative>
    </reporting-org>
    <title>
      <narrative xml:lang="en">THE MALI ELEPHANTS PROJECT, PHASE VII: DEVELOPING LONG-TERM STAKEHOLDER CAPACITY FOR ELEPHANT CONSERVATION IN MALI</narrative>
    </title>
    <description type="1">
      <narrative xml:lang="en">The long term goal is to bring tigers back to their natural carrying capacity in BBS and to bring the tiger population of BBR to a level that is both capable of sustained breeding and compatible with the human activities legally permitted within BBR. This is to be done through improving and strengthening law enforcement and human-tiger conflict mitigation in the BBS/BBR landscape.</narrative>
    </description>
    <participating-org ref="9" role="1" type="10">
